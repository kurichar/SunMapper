        <!-- NEW: Time slider + label -->

        <Button
            android:id="@+id/saveFloorButton"
            android:layout_width="100dp"
            android:layout_height="53dp"

            android:layout_marginTop="12dp"
            android:text="Select Floor"
            app:layout_constraintEnd_toEndOf="@+id/captureButton"
            app:layout_constraintTop_toBottomOf="@+id/captureButton" />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="101dp"
            android:layout_height="81dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="16dp"
            android:text="Hold to find window"
            app:layout_constraintEnd_toEndOf="@+id/sceneform_fragment"
            app:layout_constraintTop_toBottomOf="@+id/clearButton" />

